# Copy to .env and fill in real keys. Never commit .env.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
YOUTUBE_API_KEY=
TEXT_MODEL=muse-spark-1.3
TRANSCRIPTION_MODEL=muse-voice-transcribe-1.0
IMAGE_MODEL=muse-image-1.0
OPEN_MODEL_URL=
PORT=8787
# Creator archive (opt-in transcript search). OAuth client from the Google
# Cloud Console; the redirect must match GOOGLE_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/archive/oauth/callback
# 32 random bytes as 64 hex chars. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ARCHIVE_TOKEN_KEY=
ARCHIVE_DB_PATH=./archive.db
